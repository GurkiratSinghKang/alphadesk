# ---------------------------------------------------------------------------
# Global options block (must come before any site blocks)
# ---------------------------------------------------------------------------
# Timeouts close the slow-loris / slow-body hole — a client that opens a
# connection and dribbles bytes forever will now be dropped:
#   read_header  : how long to wait for the full request line + headers
#   read_body    : how long to wait for the full request body
#   write        : how long we'll spend sending the response
#   idle         : how long a keep-alive connection can sit idle
#
# Without these, Caddy's defaults allow very long-lived stalled sockets that
# tie up worker slots. See P38 (Caddy has no rate-limit directive).
#
# NOTE: Caddy core has NO built-in per-IP rate_limit directive. A real QPS
# cap requires the third-party `caddy-ratelimit` plugin (github.com/mholt/
# caddy-ratelimit). Without the plugin, timeouts + max_request_body below
# close the slow-loris class of abuse but do NOT bound request-per-second.
# TODO: install caddy-ratelimit plugin and add a `rate_limit` handler here
#       once we rebuild the Caddy image with xcaddy. Until then, per-IP QPS
#       caps live at the application layer (see auth.py `_check_rate_limit`
#       and agents.py `_enforce_chat_rate_limit`).
{
    servers {
        timeouts {
            read_header 5s
            read_body   10s
            write       30s
            idle        120s
        }
        # 64KB cap on request headers — defence against header-bomb / slowloris
        # where a peer dribbles in endless headers to exhaust memory. Request
        # *body* cap lives per-site below (Caddyfile grammar puts `request_body`
        # inside the site block, not here).
        max_header_size 64KB
    }
}

{$DOMAIN:localhost} {
    # Per-site request body cap (2 MB) — slow-body defence. Anything larger
    # than this is rejected early instead of buffered. JSON payloads for our
    # endpoints are a few KB at most; 2 MB leaves generous headroom for
    # future file-upload-ish endpoints without permitting multi-GB dribbles.
    request_body {
        max_size 2MB
    }

    # Access log — without this, Caddy logs only errors to stderr and we have
    # no audit trail of who hit what. ``json`` format is what our aggregator
    # expects. Rotation is handled by Caddy itself (100 MB per file, 10 files
    # retained, 720h = 30d max age) so the container volume does not fill.
    log {
        output file /var/log/caddy/access.log {
            roll_size 100MB
            roll_keep 10
            roll_keep_for 720h
        }
        format json
        level INFO
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        # BUG-045: X-XSS-Protection is deprecated. The legacy XSS auditor it
        # activated has been removed from every modern browser (Chrome 78+,
        # Edge 17+, Firefox never shipped it, Safari removed it). Leaving it
        # set to "1; mode=block" is worse than nothing on older browsers
        # because the auditor itself introduced XSS primitives. Explicitly
        # disable it so any intermediate proxy that might re-enable a default
        # gets overridden. See OWASP Secure Headers Project, RFC-ietf-httpbis.
        X-XSS-Protection "0"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Round-6 L-6: full Permissions-Policy denylist. Previously only
        # camera/microphone/geolocation were locked down. Browsers default
        # newly-shipped permissions to ``allow`` if the policy doesn't
        # list them, so default-deny posture must be explicit.
        # ``fullscreen=(self)`` keeps the in-app full-screen chart toggle
        # working without permitting cross-origin iframes to take over.
        # ``web-share`` is intentionally omitted: Chromium no longer
        # recognizes it as a Permissions-Policy feature and logs a warning on
        # every navigation when it is present.
        Permissions-Policy "accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=(), interest-cohort=()"
        # Round-6 L-7: cross-origin isolation headers.
        # COOP "same-origin" prevents window stealing across origins.
        # COEP "credentialless" enforces that any cross-origin
        # subresource MUST either declare CORP or be loaded without
        # credentials. CORP "same-site" prevents cross-site image-load
        # fingerprinting / Spectre side channels.
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Embedder-Policy "credentialless"
        Cross-Origin-Resource-Policy "same-site"
        # CSP — Wave 3M / persona-91 fix. The authoritative CSP is now emitted
        # per-request by the Next.js Proxy (frontend/src/proxy.ts), which
        # mints a fresh nonce for every dashboard response. Caddy still emits
        # a *fallback* CSP for paths that never hit the proxy (API JSON
        # responses, static assets served by the frontend runtime under
        # /_next/static, health probes). This fallback drops 'unsafe-inline'
        # entirely — JSON responses and bundled JS files don't need it — and
        # drops ws:// from connect-src so production only tolerates wss://.
        #
        # CSP — INCIDENT 2026-04-20 13:43 ET. Wave 3M's nonce-based CSP
        # via Next.js proxy.ts broke login because prerendered HTML pages
        # contained inline scripts whose nonce was baked in at build
        # time; the middleware was patched to stop emitting a CSP header
        # and Caddy forced ``'unsafe-inline'`` for scripts so cached HTML
        # worked.
        #
        # Round-6 L-2 attempted to drop ``'unsafe-inline'`` from
        # script-src by rebuilding layout with WebVitalsReporter.tsx as
        # a regular React component. INCIDENT 2026-04-24 — the strict
        # CSP shipped before the matching frontend image was actually
        # deployed (compose pulled the new tag but the runtime
        # container was never recreated, a recurring class of
        # mixed-state deploys for this stack). Old layout's inline
        # bootstrap scripts were CSP-blocked → page never hydrated in
        # browsers (curl returned 200; Chrome saw a blank page).
        # Hot-fix: revert ``'unsafe-inline'`` for both script-src and
        # style-src until the deploy script reliably swaps the
        # frontend container. Reintroducing the strict CSP is gated on
        # M-2 (deploy.yml smoke test repair) plus a confirmed image
        # swap step. ``base-uri 'self'``, ``form-action 'self'``,
        # ``object-src 'none'``, and ``upgrade-insecure-requests``
        # remain in place — those close gaps left implicit and don't
        # depend on the frontend build.
        #
        # Audit P2-02 (2026-05-05): the Report-Only stricter policy that
        # used to live alongside this header has been merged into the
        # enforced header below — same allowed sources, same report-uri,
        # plus ``'unsafe-inline'`` retained until the inline-bootstrap
        # migration lands. Console captures showed Report-Only had been
        # in place long enough to inventory inline usage; the next step
        # is enforcement. Browsers will now BLOCK CSP-violating loads
        # rather than silently logging them. Move to nonce-based or
        # hash-based ``script-src`` when M-2 (deploy.yml smoke test
        # repair) lets us drop ``'unsafe-inline'`` without risking
        # another blank-page incident.
        >Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' wss://{$DOMAIN:localhost}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests; report-uri /api/v1/security/csp-report"
        -Server
        -X-Powered-By
        # BUG-051: strip the ``Via: 1.1 Caddy`` response header. Leaking the
        # proxy software + version in every response narrows the attacker's
        # reconnaissance window (version-specific CVEs, handler quirks). The
        # header has no end-user value on a single-hop architecture.
        -Via
    }

    # Compression — gzip only.
    # K-3 attempted ``encode br gzip`` for ~20% better compression on
    # JS/JSON, but ``caddy:2-alpine`` does NOT include the brotli
    # encoder module: ``module not registered: http.encoders.br`` →
    # Caddy crash-loops on startup. Discovered during the Round-6
    # deploy that finally forced a Caddy restart (every prior deploy
    # silently kept the old config because bind-mount changes don't
    # trigger ``compose up`` to recreate the container, so the broken
    # config never reached a started container). To enable brotli we
    # need a custom Caddy build with ``github.com/dunglas/caddy-cbrotli``
    # baked in — tracked as a follow-up. For now: gzip-only.
    encode gzip

    handle /api/* {
        # Propagate / mint a request id at the edge so Caddy's JSON access log
        # and the backend logs can be joined on the same uuid when debugging a
        # user-reported issue. If a client already set X-Request-ID, Caddy's
        # {http.request.uuid} placeholder still yields a fresh value — the
        # backend middleware in backend/main.py honours the inbound header
        # first, so an existing id survives end-to-end.
        request_header X-Request-ID {http.request.uuid}
        reverse_proxy backend:8000
    }
    handle /ws {
        reverse_proxy backend:8000
    }
    # Health endpoints — A3#1 fix. The backend exposes /livez (liveness),
    # /readyz (readiness), and /health (legacy compose alias for /livez)
    # at the root path in backend/main.py. Without these handle blocks the
    # default `handle { reverse_proxy frontend:3000 }` below swallows them,
    # the frontend returns a 404, and uptime checks erroneously flip the
    # service to "down" while the backend is healthy. Uptime probes can now
    # hit tradingalpha.net/livez (etc.) and get a real backend JSON 200.
    handle /livez {
        reverse_proxy backend:8000
    }
    handle /readyz {
        reverse_proxy backend:8000
    }
    # M-3 (Round-7): /readyz-full is the deep readiness probe — DB +
    # Redis + Alpaca round-trip — exposed by backend/main.py for the
    # deploy.yml smoke test. Without this handle block Caddy would
    # route the request to the frontend (default handler) and the
    # smoke test would interpret a Next.js 404 as a deploy failure.
    handle /readyz-full {
        reverse_proxy backend:8000
    }
    handle /health {
        reverse_proxy backend:8000
    }
    # /healthz (K8s convention) — backend/main.py adds this as an alias to
    # /livez. Caddy needs an explicit route or the default handler swallows it.
    handle /healthz {
        reverse_proxy backend:8000
    }
    # /status/* handler removed 2026-04-18 — it pointed at uptime-kuma:3001,
    # which was deleted from docker-compose.prod.yml on 2026-04-17. Caddy was
    # returning 502s (with a basic-auth prompt first, which made it look like
    # the service was up). Requests to /status now fall through to the
    # default frontend handler and receive a Next.js 404 — the correct
    # response for a route that no longer exists. When a real health
    # dashboard lands (Grafana / Netdata), re-add a /status/* handler.
    # See observability-audit-r4.md P2 #15.
    handle {
        reverse_proxy frontend:3000
    }
}
