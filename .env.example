# =============================================================================
# AlphaDesk Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Application ---
ENVIRONMENT=dev          # dev | staging | prod
DEBUG=true
LOG_LEVEL=INFO

# --- Database (TimescaleDB) ---
DATABASE_URL=postgresql+asyncpg://alphadesk:alphadesk_dev@localhost:5432/alphadesk

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Market Data: Polygon.io ---
# Sign up at https://polygon.io — requires Stocks Developer + Options Developer tiers
POLYGON_API_KEY=

# --- Market Data: Financial Modeling Prep ---
# Sign up at https://site.financialmodelingprep.com — Starter tier or above
# Provides earnings calendar (EPS estimate vs actual for SUE), fundamentals, analyst consensus
FMP_API_KEY=

# --- Market Data: Theta Data ---
# Sign up at https://www.thetadata.net
THETA_DATA_API_KEY=

# --- Market Data: Unusual Whales ---
# Sign up at https://unusualwhales.com
UNUSUAL_WHALES_API_KEY=

# --- Broker: Alpaca ---
# Sign up at https://alpaca.markets (paper trading is free)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Broker: Interactive Brokers ---
# IB Gateway or TWS must be running locally
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

# --- AI: Anthropic ---
# Get your API key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# auto = API key first, then local CLI fallback; api = force API; cli = force CLI
CLAUDE_BACKEND=auto
# Logs raw Claude requests/responses to logs/claude/*.jsonl when true.
# Enable only on secured machines; prompts can include user/trading context.
CLAUDE_AUDIT_LOG_ENABLED=false
CLAUDE_AUDIT_LOG_DIR=logs/claude
CLAUDE_AUDIT_LOG_MAX_CHARS=200000

# --- AI: TradingAgents Research ---
# External research artifact generator. Read-only; never routes orders.
TRADINGAGENTS_ENABLED=true
TRADINGAGENTS_SCRIPT_PATH=
TRADINGAGENTS_SKILL_HOME=
TRADINGAGENTS_PROVIDER=anthropic
TRADINGAGENTS_DEEP_MODEL=claude-sonnet-4-6
TRADINGAGENTS_QUICK_MODEL=claude-haiku-4-5
TRADINGAGENTS_OUTPUT_LANGUAGE=English
# Minimum timeout floor. Full four-analyst graphs get a larger adaptive budget.
TRADINGAGENTS_TIMEOUT_S=900
TRADINGAGENTS_RUNS_PER_HOUR=12
# Set the key for whichever TRADINGAGENTS_PROVIDER you choose.
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# --- Notifications: Telegram ---
# Create a bot via @BotFather and get your chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Notifications: Discord ---
# Create a webhook in your Discord channel settings
DISCORD_WEBHOOK_URL=

# --- Webhooks: TradingView ---
# Set this to a random secret string and configure the same in TradingView alerts
TRADINGVIEW_WEBHOOK_SECRET=
