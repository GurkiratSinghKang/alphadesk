[Unit]
Description=Daily AlphaDesk TimescaleDB backup
Documentation=file:///opt/alphadesk/infrastructure/backup.sh
Requires=alphadesk-backup.service

[Timer]
# 04:00 America/New_York — tz-aware so DST transitions keep the backup
# pinned to the same wall-clock time in NY (operator convenience; 04:00
# ET is consistently well after MOC reconciliation has drained). Wave 4R
# Fix 5: previously OnCalendar=*-*-* 08:00:00 UTC, which drifted one hour
# across DST boundaries — in summer that lands at 04:00 ET, but in winter
# at 03:00 ET, creating an ops inconsistency in when the backup runs
# relative to the trading-day boundary. Requires systemd >= 252 for
# tz-aware OnCalendar; all supported targets ship >= 249 today but
# every prod host is Debian 12 bookworm (systemd 252) or Ubuntu 22.04.
OnCalendar=*-*-* 04:00:00 America/New_York
# Run missed jobs (e.g. if the VPS was down at the scheduled time).
Persistent=true
# Small randomised delay to avoid thundering-herd when many VPSes share a host.
RandomizedDelaySec=5min
Unit=alphadesk-backup.service

[Install]
WantedBy=timers.target
