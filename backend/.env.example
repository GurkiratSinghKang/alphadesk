# =============================================================================
# AlphaDesk Backend — Environment Template
# -----------------------------------------------------------------------------
# Copy to `backend/.env` (or the repo-root `.env`, which pydantic-settings also
# loads) and fill in your own values. Dummy values below are for documentation
# only — the backend refuses to start when JWT_SECRET and ADMIN_PASSWORD_HASH
# are blank, and paper/live trading will fail without ALPACA_* credentials.
#
# This file is safe to commit. Do NOT commit the real `.env` — it's listed in
# `.gitignore` for that reason.
#
# Every variable listed here maps to a field on `backend.core.config.Settings`
# (see backend/core/config.py for types and defaults). Keep this file in sync
# whenever a new Settings field is added.
# =============================================================================

# --- Application ------------------------------------------------------------
# Runtime mode: dev | staging | prod. Default in Settings is `prod` (safer) —
# only set `dev` on a developer laptop. `prod` enables strict cookies, hides
# /docs and /redoc, and refuses insecure defaults.
ENVIRONMENT=dev
DEBUG=true
LOG_LEVEL=INFO

# --- Database (TimescaleDB) -------------------------------------------------
# The async driver prefix `postgresql+asyncpg://` is required. The prod
# docker-compose overrides this to point at the `timescaledb` service.
DATABASE_URL=postgresql+asyncpg://alphadesk:alphadesk_dev@localhost:5432/alphadesk
# docker-compose.prod.yml interpolates this into DATABASE_URL and the compose
# postgres service. REQUIRED in prod — compose will refuse to start without.
POSTGRES_PASSWORD=change-me-in-prod

# --- Redis ------------------------------------------------------------------
# The prod docker-compose builds REDIS_URL from REDIS_PASSWORD; in dev you can
# set REDIS_URL directly to the URL form.
REDIS_URL=redis://localhost:6379/0
# REQUIRED in prod. Generate with `openssl rand -hex 32`.
REDIS_PASSWORD=change-me-in-prod

# --- Market Data: Polygon.io ------------------------------------------------
# Sign up at https://polygon.io — Stocks Developer + Options Developer tiers.
POLYGON_API_KEY=pk_live_polygon_example_replace

# --- Market Data: Financial Modeling Prep -----------------------------------
# Sign up at https://site.financialmodelingprep.com — Starter tier or above.
# Provides earnings calendar (EPS estimate vs actual for SUE), fundamentals,
# analyst consensus.
FMP_API_KEY=fmp_example_replace

# --- Market Data: Theta Data ------------------------------------------------
THETA_DATA_API_KEY=

# --- Market Data: Unusual Whales --------------------------------------------
UNUSUAL_WHALES_API_KEY=

# --- Broker: Alpaca ---------------------------------------------------------
# Sign up at https://alpaca.markets. Use paper-api URL unless live-trading is
# explicitly enabled (see LIVE_TRADING_ENABLED below).
ALPACA_API_KEY=PKEXAMPLE_REPLACE
ALPACA_SECRET_KEY=secret_replace_me
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Required when users store broker credentials through Settings. Generate with
# `openssl rand -hex 32`; rotating it requires re-entering saved broker keys.
BROKER_CREDENTIAL_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32-output
# Toggles the broker trade_updates WebSocket subscription in
# data/ingestion/alpaca_stream.py. Leave on unless the broker-side WS is
# misbehaving — this is the oncall kill-switch that avoids a redeploy.
ALPACA_TRADE_UPDATES_ENABLED=true
# Safety flag checked by api/routes/trades.py before routing any order to a
# non-paper base URL. Must be explicitly `true` AND ALPACA_BASE_URL must point
# at `api.alpaca.markets`. Leaving unset keeps the platform in paper-only
# mode regardless of base URL.
LIVE_TRADING_ENABLED=false

# --- Broker: Interactive Brokers --------------------------------------------
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

# --- AI: Anthropic ----------------------------------------------------------
# Optional — if unset, the agents fall back to the Claude CLI credentials
# mounted at /root/.claude in the prod container (see docker-compose.prod.yml
# backend service). Leaving this empty is the common prod configuration.
ANTHROPIC_API_KEY=

# --- AI: TradingAgents Research --------------------------------------------
# Optional external research desk. This is read-only and does not feed order
# routing. The wrapper bootstraps the pinned upstream repo on first run.
TRADINGAGENTS_ENABLED=true
TRADINGAGENTS_SCRIPT_PATH=
TRADINGAGENTS_SKILL_HOME=
TRADINGAGENTS_PROVIDER=anthropic
TRADINGAGENTS_DEEP_MODEL=claude-sonnet-4-6
TRADINGAGENTS_QUICK_MODEL=claude-haiku-4-5
TRADINGAGENTS_OUTPUT_LANGUAGE=English
TRADINGAGENTS_TIMEOUT_S=600
TRADINGAGENTS_HISTORY_LIMIT=20
TRADINGAGENTS_MAX_DECISION_CHARS=16000
TRADINGAGENTS_RUNS_PER_HOUR=12
# Set the key for whichever TRADINGAGENTS_PROVIDER you choose.
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# --- News -------------------------------------------------------------------
NEWSDATA_API_KEY=

# --- Notifications: Telegram ------------------------------------------------
# Create a bot via @BotFather and get your chat id via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Notifications: Discord -------------------------------------------------
DISCORD_WEBHOOK_URL=

# --- Webhooks: TradingView --------------------------------------------------
# Random secret — match it in the TradingView alert payload.
TRADINGVIEW_WEBHOOK_SECRET=

# --- Dev helpers ------------------------------------------------------------
# If true, main.py skips the Postgres init on startup. Every DB-backed route
# will return empty results and every response carries X-Alphadesk-Warning.
# Only useful for frontend dev against a dead DB; never set in prod.
SKIP_DB_INIT=false

# --- Auth -------------------------------------------------------------------
# REQUIRED in every environment. Generate with `openssl rand -hex 32`. The
# backend raises on import if this is unset (see Settings.jwt_secret_value).
JWT_SECRET=replace-with-openssl-rand-hex-32-output
ADMIN_USERNAME=admin
# bcrypt hash. Generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt(rounds=12)).decode())"
ADMIN_PASSWORD_HASH=$2b$12$EXAMPLE_REPLACE_WITH_REAL_BCRYPT_HASH
# Access tokens are valid for 8h by default (trading terminal stays open all
# day); refresh tokens for 30d.
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Production -------------------------------------------------------------
# Full https:// origin of the frontend. Added to the CORS allowlist alongside
# the two localhost entries. Leave unset in dev.
PRODUCTION_ORIGIN=


# Alpaca market-data WS feed: 'iex' (free, default) or 'sip' (paid Algo Trader Plus)
ALPACA_STREAM_FEED=iex
