# =============================================================================
# AlphaDesk Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Application ---
ENVIRONMENT=dev          # dev | staging | prod
DEBUG=true
LOG_LEVEL=INFO

# --- Database (TimescaleDB) ---
DATABASE_URL=postgresql+asyncpg://alphadesk:alphadesk_dev@localhost:5432/alphadesk

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Market Data: Polygon.io ---
# Sign up at https://polygon.io (free tier available)
POLYGON_API_KEY=

# --- Market Data: Theta Data ---
# Sign up at https://www.thetadata.net
THETA_DATA_API_KEY=

# --- Market Data: Unusual Whales ---
# Sign up at https://unusualwhales.com
UNUSUAL_WHALES_API_KEY=

# --- Broker: Alpaca ---
# Sign up at https://alpaca.markets (paper trading is free)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Broker: Interactive Brokers ---
# IB Gateway or TWS must be running locally
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

# --- AI: Anthropic ---
# Get your API key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Notifications: Telegram ---
# Create a bot via @BotFather and get your chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Notifications: Discord ---
# Create a webhook in your Discord channel settings
DISCORD_WEBHOOK_URL=

# --- Webhooks: TradingView ---
# Set this to a random secret string and configure the same in TradingView alerts
TRADINGVIEW_WEBHOOK_SECRET=
