# ---------------------------------------------------------------------------
# Global options block (must come before any site blocks)
# ---------------------------------------------------------------------------
# Timeouts close the slow-loris / slow-body hole — a client that opens a
# connection and dribbles bytes forever will now be dropped:
#   read_header  : how long to wait for the full request line + headers
#   read_body    : how long to wait for the full request body
#   write        : how long we'll spend sending the response
#   idle         : how long a keep-alive connection can sit idle
#
# Without these, Caddy's defaults allow very long-lived stalled sockets that
# tie up worker slots. See P38 (Caddy has no rate-limit directive).
#
# NOTE: Caddy core has NO built-in per-IP rate_limit directive. A real QPS
# cap requires the third-party `caddy-ratelimit` plugin (github.com/mholt/
# caddy-ratelimit). Without the plugin, timeouts + max_request_body below
# close the slow-loris class of abuse but do NOT bound request-per-second.
# TODO: install caddy-ratelimit plugin and add a `rate_limit` handler here
#       once we rebuild the Caddy image with xcaddy. Until then, per-IP QPS
#       caps live at the application layer (see auth.py `_check_rate_limit`
#       and agents.py `_enforce_chat_rate_limit`).
{
    servers {
        timeouts {
            read_header 5s
            read_body   10s
            write       30s
            idle        120s
        }
        # 64KB cap on request headers — defence against header-bomb / slowloris
        # where a peer dribbles in endless headers to exhaust memory. Request
        # *body* cap lives per-site below (Caddyfile grammar puts `request_body`
        # inside the site block, not here).
        max_header_size 64KB
    }
}

{$DOMAIN:localhost} {
    # Per-site request body cap (2 MB) — slow-body defence. Anything larger
    # than this is rejected early instead of buffered. JSON payloads for our
    # endpoints are a few KB at most; 2 MB leaves generous headroom for
    # future file-upload-ish endpoints without permitting multi-GB dribbles.
    request_body {
        max_size 2MB
    }

    # Access log — without this, Caddy logs only errors to stderr and we have
    # no audit trail of who hit what. ``json`` format is what our aggregator
    # expects. Rotation is handled by Caddy itself (100 MB per file, 10 files
    # retained, 720h = 30d max age) so the container volume does not fill.
    log {
        output file /var/log/caddy/access.log {
            roll_size 100MB
            roll_keep 10
            roll_keep_for 720h
        }
        format json
        level INFO
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        # CSP — Wave 3M / persona-91 fix. The authoritative CSP is now emitted
        # per-request by the Next.js Proxy (frontend/src/proxy.ts), which
        # mints a fresh nonce for every dashboard response. Caddy still emits
        # a *fallback* CSP for paths that never hit the proxy (API JSON
        # responses, static assets served by the frontend runtime under
        # /_next/static, health probes). This fallback drops 'unsafe-inline'
        # entirely — JSON responses and bundled JS files don't need it — and
        # drops ws:// from connect-src so production only tolerates wss://.
        #
        # `?Content-Security-Policy` uses Caddy's "default" prefix: the
        # header is set ONLY if the upstream response didn't already set
        # it. That lets Next's proxy-emitted nonce-based CSP pass through
        # unchanged for HTML responses while we still cover the non-HTML
        # paths (API JSON, /livez, /_next/static) with this fallback.
        # See: https://caddyserver.com/docs/caddyfile/directives/header
        ?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' wss://{$DOMAIN:localhost}; frame-ancestors 'none'"
        -Server
        -X-Powered-By
    }

    # Compression
    encode zstd gzip

    handle /api/* {
        # Propagate / mint a request id at the edge so Caddy's JSON access log
        # and the backend logs can be joined on the same uuid when debugging a
        # user-reported issue. If a client already set X-Request-ID, Caddy's
        # {http.request.uuid} placeholder still yields a fresh value — the
        # backend middleware in backend/main.py honours the inbound header
        # first, so an existing id survives end-to-end.
        request_header X-Request-ID {http.request.uuid}
        reverse_proxy backend:8000
    }
    handle /ws {
        reverse_proxy backend:8000
    }
    # Health endpoints — A3#1 fix. The backend exposes /livez (liveness),
    # /readyz (readiness), and /health (legacy compose alias for /livez)
    # at the root path in backend/main.py. Without these handle blocks the
    # default `handle { reverse_proxy frontend:3000 }` below swallows them,
    # the frontend returns a 404, and uptime checks erroneously flip the
    # service to "down" while the backend is healthy. Uptime probes can now
    # hit tradingalpha.net/livez (etc.) and get a real backend JSON 200.
    handle /livez {
        reverse_proxy backend:8000
    }
    handle /readyz {
        reverse_proxy backend:8000
    }
    handle /health {
        reverse_proxy backend:8000
    }
    # /status/* handler removed 2026-04-18 — it pointed at uptime-kuma:3001,
    # which was deleted from docker-compose.prod.yml on 2026-04-17. Caddy was
    # returning 502s (with a basic-auth prompt first, which made it look like
    # the service was up). Requests to /status now fall through to the
    # default frontend handler and receive a Next.js 404 — the correct
    # response for a route that no longer exists. When a real health
    # dashboard lands (Grafana / Netdata), re-add a /status/* handler.
    # See observability-audit-r4.md P2 #15.
    handle {
        reverse_proxy frontend:3000
    }
}
