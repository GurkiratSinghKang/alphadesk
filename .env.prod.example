# =============================================================================
# AlphaDesk — `.env.prod` Template
# -----------------------------------------------------------------------------
# Copy to `.env.prod` on the VPS (at /opt/alphadesk/.env.prod). The GHA
# deploy workflow (.github/workflows/deploy.yml) `set -a; . ./.env.prod; set +a`
# into the shell before running `docker compose up`, so every variable listed
# here is available for compose interpolation (${VAR} and ${VAR:?msg} forms).
#
# This file is a TEMPLATE. Commit as-is; fill in real values only on the VPS.
# Real secrets must never enter git history.
#
# The backend's own per-process env vars (POLYGON_API_KEY, FMP_API_KEY,
# JWT_SECRET, etc.) live in `backend/.env.example` — they're loaded by
# pydantic-settings at import time and do NOT need to be duplicated here.
# This file contains ONLY the variables compose itself interpolates.
# =============================================================================

# --- Compose interpolation: secrets -----------------------------------------
# Used by the timescaledb and backend services (see docker-compose.prod.yml).
# Generate each with `openssl rand -hex 32`. Compose refuses to start when
# either is blank (the `${VAR:?...}` form makes the error loud).
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32-output
REDIS_PASSWORD=replace-with-openssl-rand-hex-32-output

# --- Compose interpolation: /status basic-auth ------------------------------
# The Caddyfile gates the (currently disabled) /status endpoint with basic
# auth. STATUS_USER defaults to `admin` in compose. STATUS_PASS_HASH must be
# a Caddy-compatible bcrypt hash — generate with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
STATUS_USER=admin
STATUS_PASS_HASH=$2a$14$REPLACE_WITH_CADDY_BCRYPT_OUTPUT

# --- Compose interpolation: image tags --------------------------------------
# The deploy workflow sets these to the just-built images:
#   FRONTEND_IMAGE=ghcr.io/<owner>/alphadesk-frontend:<sha>
#   BACKEND_IMAGE=ghcr.io/<owner>/alphadesk-backend:<sha>
# Leaving them unset falls back to `ghcr.io/OWNER/alphadesk-*:latest` (the
# placeholder defaults in docker-compose.prod.yml) — useful only for initial
# bring-up when there is no build yet.
FRONTEND_IMAGE=
BACKEND_IMAGE=

# --- Compose interpolation: domain + TLS ------------------------------------
# Public hostname Caddy binds certificates to. Caddy will attempt ACME
# (Let's Encrypt) against this name on first start, so it MUST resolve to
# the VPS public IP before the first `docker compose up`.
DOMAIN=tradingalpha.net

# --- Application: CORS / cookie origin --------------------------------------
# Used by the backend's CORS middleware (backend/main.py). Must be the exact
# https:// origin users visit — no trailing slash.
PRODUCTION_ORIGIN=https://tradingalpha.net
